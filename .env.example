# HuggingFace Configuration
# Get your token from https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_token_here

# Model to use for translation
# Example: "meta-llama/CodeLlama-7b-hf" or "Qwen/Qwen2.5-Coder-7B-Instruct"
MODEL_ID=your_model_id_here

# API Key for protecting endpoints
# Generate a secure random key for production
API_KEY=your_api_key_here

# Flask Configuration
FLASK_PORT=5000
FLASK_DEBUG=false

# Optional self-hosted Piston service for multi-language code execution.
# Leave blank to use the local Python-only runner.
PISTON_URL=
# Example: PISTON_URL=http://127.0.0.1:2000

