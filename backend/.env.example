# Hugging Face API Configuration
HF_API_TOKEN=your_huggingface_token_here
MODEL_ID=your_model_id_here

# Flask Configuration
FLASK_PORT=5000
FLASK_DEBUG=false

# Optional self-hosted Piston service for multi-language code execution.
# Leave blank to use the local Python-only runner.
PISTON_URL=
# Example: PISTON_URL=http://127.0.0.1:2000

